										"paddingX": 0,
										"paddingY": 0
									},
									"scroll": true
								},
								"pageStack": {
									"enabled": true,
									"sectionPaddingX": 12,
									"itemPaddingX": 20,
									"paddingY": 28,
									"divider": {
										"type": "section"
									}
								}
							},
							"bottom": {
								"props": {
									"position": "fixed",
									"layout": {
										"direction": "column",
										"gap": 0
									},
									"safeArea": true,
									"zIndex": 10
								}
							}
						}
					}
