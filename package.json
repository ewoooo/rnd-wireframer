		"@tailwindcss/postcss": "^4.3.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"next": "^16.2.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
