{
	"name": "rnd-screen-generator",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "next dev apps/web",
		"build": "next build apps/web",
		"lint": "biome lint . && node scripts/check-react-hooks-policy.mjs apps packages",
		"format": "biome format --write .",
		"lint:hooks": "node scripts/check-react-hooks-policy.mjs apps packages",
		"smoke:pipeline": "tsx apps/smoke/src/cli.ts",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.9.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"jsdom": "^29.1.1",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.6"
	},
	"dependencies": {
		"@radix-ui/react-scroll-area": "^1.2.10",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-tabs": "^1.1.13",
		"@tailwindcss/postcss": "^4.3.0",
		"bun": "^1.3.14",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.16.0",
		"next": "^16.2.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"overrides": {
		"postcss": "^8.5.10"
	}
}
