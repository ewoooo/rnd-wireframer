{
	"name": "rnd-screen-generator",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.5.1",
	"scripts": {
		"dev": "next dev apps/web",
		"build": "next build apps/web",
		"lint": "biome lint . && node scripts/check-react-hooks-policy.mjs apps packages",
