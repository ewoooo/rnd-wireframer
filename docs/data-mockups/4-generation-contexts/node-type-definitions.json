{
	"schemaVersion": "node-type-definitions/v0.1",
	"purpose": "화면 생성 노드트리에서 사용할 nodeType별 공통 엔티티와 고유 엔티티 정의",
	"naming": {
		"nodeType": "lowerCamelCase",
		"nodeId": "kebab-case with semantic prefix",
		"composite": "PascalCase renderer component key",
		"role": "lowerCamelCase semantic role"
	},
	"commonEntities": {
		"NodeIdentity": {
			"description": "모든 노드가 반드시 갖는 식별 정보",
			"required": ["id", "nodeType"],
			"properties": {
				"id": {
					"type": "string",
					"description": "생성, 편집, 검수, 리뷰 코멘트에서 참조할 안정적인 노드 ID"
				},
				"nodeType": {
					"type": "string",
					"description": "노드의 구조적 역할"
				},
				"name": {
					"type": "string",
					"description": "사람이 읽는 노드명"
				},
				"role": {
					"type": "string",
					"description": "생성/검수/렌더러가 해석할 의미 역할"
				}
			}
		},
		"RenderEntity": {
			"description": "렌더러가 컴포지트 또는 패턴을 그릴 때 필요한 정보",
			"properties": {
				"composite": {
					"type": "string",
					"description": "실제 렌더러 컴포지트 키"
				},
				"variant": {
					"type": "string",
					"description": "동일 컴포지트 내 표현 변형"
				},
				"props": {
					"type": "object",
					"description": "정적 값, binding, template을 포함하는 렌더 props"
				}
			}
		},
		"LayoutEntity": {
			"description": "시각 배치 의도와 측정 계약",
			"properties": {
				"layout": {
					"type": "object",
					"description": "direction, spacing, padding, rail, position, sticky, alignment 등"
				}
			}
		},
		"DataEntity": {
			"description": "입력 JSON 또는 상위 반복 context와 연결되는 데이터 계약",
			"properties": {
				"dataBinding": {
					"type": "object",
					"description": "binding path, collection, itemName, key, template context"
				}
			}
		},
		"StateEntity": {
			"description": "화면 상태, variant, 조건 노출 계약",
			"properties": {
				"state": {
					"type": "object",
					"description": "default/loading/error/empty/variant 상태"
				},
				"visibility": {
					"type": "object",
					"description": "조건부 노출 규칙"
				}
			}
		},
		"ActionEntity": {
			"description": "사용자 이벤트와 상태/API 효과",
			"properties": {
				"actions": {
					"type": "array",
					"description": "event, type, target, success, failure로 구성된 interaction 목록"
				}
			}
		},
		"TraceEntity": {
			"description": "원천 문서와 생성 근거 추적 정보",
			"properties": {
				"source": {
					"type": "object",
					"description": "screenSource, areaSource, compositeSource, policy, generatedReason 등"
				}
			}
		},
		"TreeEntity": {
			"description": "자식 노드 소유 정보",
			"properties": {
				"children": {
					"type": "array",
					"description": "렌더 순서 기준의 하위 노드 목록"
				}
			}
		}
	},
	"uniqueEntities": {
		"screen": {
			"description": "하나의 모바일 화면 또는 팝업/바텀시트 surface 루트",
			"extends": ["NodeIdentity", "LayoutEntity", "StateEntity", "TraceEntity", "TreeEntity"],
			"required": ["id", "nodeType", "name", "surface", "children"],
			"uniqueProperties": {
				"surface": {
					"type": "string",
					"allowedValues": ["page", "popup", "bottomSheet"]
				},
				"route": {
					"type": "object",
					"description": "screenRouteCode, order, path hint"
				}
			},
			"allowedChildren": ["section", "area", "slot"]
		},
		"section": {
			"description": "화면 내 chrome, header, body, footer 같은 배치 구획",
			"extends": ["NodeIdentity", "LayoutEntity", "StateEntity", "TraceEntity", "TreeEntity"],
			"required": ["id", "nodeType", "role", "children"],
			"uniqueProperties": {
				"sectionKind": {
					"type": "string",
					"allowedValues": ["chrome", "content", "form", "list", "feedback", "cta", "overlay"]
				}
			},
			"allowedChildren": ["area", "pattern", "composite", "slot", "text", "action", "dataList"]
		},
		"area": {
			"description": "SB/OGN 원천과 연결되는 재사용 가능한 화면 덩어리",
			"extends": [
				"NodeIdentity",
				"RenderEntity",
				"LayoutEntity",
				"DataEntity",
				"StateEntity",
				"ActionEntity",
				"TraceEntity",
				"TreeEntity"
			],
			"required": ["id", "nodeType", "name", "composite", "source", "children"],
			"uniqueProperties": {
				"areaCode": {
					"type": "string",
					"description": "원천 OGN 코드. source.code와 같거나 source에서 유도 가능해야 한다."
				},
				"editScope": {
					"type": "string",
					"allowedValues": ["sharedArea", "screenLocalOverride"]
				}
			},
			"allowedChildren": ["pattern", "composite", "slot", "text", "action", "dataList"]
		},
		"pattern": {
			"description": "여러 컴포지트가 결합된 디자인 패턴 단위",
			"extends": [
				"NodeIdentity",
				"RenderEntity",
				"LayoutEntity",
				"DataEntity",
				"StateEntity",
				"ActionEntity",
				"TraceEntity",
				"TreeEntity"
			],
			"required": ["id", "nodeType", "composite"],
			"uniqueProperties": {
				"patternKind": {
					"type": "string",
					"allowedValues": [
						"accordion",
						"formGroup",
						"summary",
						"selectionGroup",
						"message",
						"navigation",
						"ctaGroup"
					]
				}
			},
			"allowedChildren": ["composite", "slot", "text", "action", "dataList"]
		},
		"composite": {
			"description": "cx-components 또는 프로젝트 렌더러에 매핑되는 원자/분자 컴포지트",
			"extends": [
				"NodeIdentity",
				"RenderEntity",
				"LayoutEntity",
				"DataEntity",
				"StateEntity",
				"ActionEntity",
				"TraceEntity",
				"TreeEntity"
			],
			"required": ["id", "nodeType", "composite"],
			"uniqueProperties": {
				"compositeCode": {
					"type": "string",
					"description": "수급 또는 디자인 입력의 composite code"
				}
			},
			"allowedChildren": ["slot", "text", "action", "composite"]
		},
		"slot": {
			"description": "컴포지트나 패턴 내부의 명명된 삽입 위치",
			"extends": ["NodeIdentity", "LayoutEntity", "StateEntity", "TreeEntity"],
			"required": ["id", "nodeType", "slotName", "children"],
			"uniqueProperties": {
				"slotName": {
					"type": "string",
					"description": "header, body, footer, leading, trailing, emptyState 등"
				}
			},
			"allowedChildren": ["composite", "text", "action", "dataList"]
		},
		"text": {
			"description": "렌더러 컴포지트 없이도 표현 가능한 텍스트 노드",
			"extends": ["NodeIdentity", "RenderEntity", "DataEntity", "StateEntity", "TraceEntity"],
			"required": ["id", "nodeType", "props"],
			"uniqueProperties": {
				"textRole": {
					"type": "string",
					"allowedValues": ["title", "subtitle", "body", "caption", "helper", "error"]
				}
			},
			"allowedChildren": []
		},
		"action": {
			"description": "CTA, 링크, 아이콘 버튼처럼 사용자 실행 의도가 중심인 노드",
			"extends": [
				"NodeIdentity",
				"RenderEntity",
				"LayoutEntity",
				"DataEntity",
				"StateEntity",
				"ActionEntity",
				"TraceEntity"
			],
			"required": ["id", "nodeType", "composite", "actions"],
			"uniqueProperties": {
				"actionKind": {
					"type": "string",
					"allowedValues": ["primary", "secondary", "text", "icon", "link"]
				}
			},
			"allowedChildren": []
		},
		"dataList": {
			"description": "collection binding을 기준으로 자식 template을 반복 렌더링하는 노드",
			"extends": [
				"NodeIdentity",
				"LayoutEntity",
				"DataEntity",
				"StateEntity",
				"TraceEntity",
				"TreeEntity"
			],
			"required": ["id", "nodeType", "dataBinding", "children"],
			"uniqueProperties": {
				"emptyStateNodeId": {
					"type": "string",
					"description": "collection이 비었을 때 대신 노출할 노드 ID"
				},
				"maxItems": {
					"type": "number",
					"description": "렌더 최대 개수 제한"
				}
			},
			"allowedChildren": ["pattern", "composite", "slot", "text", "action"]
		}
	},
	"validationNotes": [
		"모든 노드는 NodeIdentity를 포함해야 한다.",
		"composite가 있는 노드는 renderer registry에 같은 키가 있어야 한다.",
		"dataList는 dataBinding.collection과 dataBinding.itemName을 반드시 가져야 한다.",
		"source.type이 areaSource이면 source.code는 원천 area code와 매칭되어야 한다.",
		"allowedChildren에 없는 nodeType은 생성 결과 검수에서 실패 처리한다."
	]
}
