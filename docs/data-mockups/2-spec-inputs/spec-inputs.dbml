Project spec_inputs {
  database_type: 'PostgreSQL'
  Note: '''
    DBML preview for docs/data-mockups/2-spec-inputs/examples/.
    This is a review artifact for drawDB import, not a Supabase migration.

    Source files:
    - sql-screen-routes.json
    - sql-screen-source.json
    - sql-area-source.json
    - sql-composite-entry.json

    process_refs and policy_refs are placeholders for references defined by
    docs/data-mockups/1-policy-inputs/.
  '''
}

Table spec_modules {
  code text [pk, note: 'Root-level module value in route, screen source, and area source files']
}

Table process_refs {
  code text [pk, note: 'External reference to policy_processes.code']
}

Table policy_refs {
  code text [pk, note: 'External reference to policies.code']
}

Table screen_routes {
  code text [pk, note: 'screenRoutes[].code']
  module_code text [not null, note: 'Root-level module']
  process_code text [not null, note: 'screenRoutes[].processCode']
  name text [not null]

  indexes {
    module_code
    process_code
  }
}

Table screen_variants {
  code text [pk, note: 'screenVariants[].code']
  screen_route_code text [not null, note: 'screenVariants[].screenRouteCode']
  sort_order integer [not null, note: 'screenVariants[].order']
  variant_type text [not null, note: 'screenVariants[].variantType']
  follow_up text [note: 'screenVariants[].followUp']

  indexes {
    screen_route_code
    (screen_route_code, sort_order) [unique]
  }
}

Table screen_sources {
  code text [pk, note: 'screenSources[].meta.code']
  screen_variant_code text [not null, note: 'screenSources[].screenVariantCode']
  name text [not null, note: 'screenSources[].meta.name']
  description text [note: 'screenSources[].meta.description']
  surface text [note: 'screenSources[].meta.surface']

  indexes {
    screen_variant_code
  }
}

Table screen_area_usages {
  code text [pk, note: 'Unique usage id for area placed in screen']
  screen_code text [not null]
  area_code text [not null]
  sort_order integer [not null, note: 'screenSources[].areas[].order']

  indexes {
    screen_code
    area_code
    (screen_code, sort_order) [unique]
  }
}

Table area_sources {
  code text [pk, note: 'meta.code']
  module_code text [not null, note: 'meta.module']
  name text [not null, note: 'meta.name']
  description text [note: 'meta.description']
  layout_flow text [note: 'layout.flow']

  indexes {
    module_code
  }
}

Table area_variants {
  area_code text [not null]
  variant_code text [not null, note: 'variants[].code']
  trigger text
  action text

  indexes {
    (area_code, variant_code) [pk]
  }
}

Table area_composite_usages {
  code text [pk, note: 'Unique usage id for component placed in area']
  area_code text [not null]
  composite_code text [not null]
  sort_order integer [not null, note: 'composites[].order']
  policy_code text [note: 'composites[].policyCode']
  property jsonb [note: 'composites[].property']

  indexes {
    area_code
    composite_code
    (area_code, sort_order) [unique]
    policy_code
  }
}

Table area_variant_visible_composite_usages {
  area_code text [not null]
  variant_code text [not null]
  area_composite_usage_code text [not null]

  indexes {
    (area_code, variant_code, area_composite_usage_code) [pk]
    area_composite_usage_code
  }
}

Table area_notices {
  area_code text [not null]
  policy_code text [not null]
  notice_type text [not null, note: 'notices[].noticeType']
  description text

  indexes {
    (area_code, policy_code, notice_type) [pk]
    policy_code
  }
}

Table composites {
  code text [pk, note: 'composites[].code']
  composite_type text [not null, note: 'composites[].compositeType']
  property jsonb [not null, default: '{}', note: 'composites[].property']

  indexes {
    composite_type
  }
}

Ref: screen_routes.module_code > spec_modules.code
Ref: screen_routes.process_code > process_refs.code

Ref: screen_variants.screen_route_code > screen_routes.code

Ref: screen_sources.screen_variant_code > screen_variants.code

Ref: screen_area_usages.screen_code > screen_sources.code
Ref: screen_area_usages.area_code > area_sources.code

Ref: area_sources.module_code > spec_modules.code

Ref: area_variants.area_code > area_sources.code

Ref: area_composite_usages.area_code > area_sources.code
Ref: area_composite_usages.composite_code > composites.code
Ref: area_composite_usages.policy_code > policy_refs.code

Ref: area_variant_visible_composite_usages.(area_code, variant_code) > area_variants.(area_code, variant_code)
Ref: area_variant_visible_composite_usages.area_composite_usage_code > area_composite_usages.code

Ref: area_notices.area_code > area_sources.code
Ref: area_notices.policy_code > policy_refs.code
