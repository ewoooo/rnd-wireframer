{
	"patterns": [
		{
			"id": "term-agreement-screen",
			"target": "screen",
			"name": "약관 동의 화면",
			"description": "상단 앱바, 스크롤 약관 콘텐츠, 선택적 하단 액션을 쓰는 약관 동의 화면 프리셋",
			"defaultVariant": "default",
			"variants": {
				"default": {
					"regions": {
						"header": {
							"props": {
								"position": "fixed",
								"layout": { "direction": "column", "gap": 0 },
								"height": 48,
								"zIndex": 10
							}
						},
						"contents": {
							"props": {
								"layout": { "direction": "column", "gap": 0, "paddingX": 0, "paddingY": 0 },
								"scroll": true
							},
							"pageStack": {
								"enabled": true,
								"sectionPaddingX": 12,
								"itemPaddingX": 20,
								"paddingY": 28,
								"divider": { "type": "section" }
							}
						},
						"bottom": {
							"props": {
								"position": "fixed",
								"layout": { "direction": "column", "gap": 0 },
								"safeArea": true,
								"zIndex": 10
							}
						}
					}
				}
			},
			"chrome": {
				"header": [],
				"bottom": []
			},
			"expects": {
				"contents": { "organismPatterns": ["term-list"] }
			},
			"resolution": {
				"organismPatterns": { "anyOf": ["term-list"] },
				"nameKeywords": ["약관 동의", "term agreement"],
				"priority": 100
			},
			"guidance": {
				"keywords": ["screen", "route", "layout", "화면", "스크린", "약관 동의 화면"]
			},
			"examples": []
		},
