// ============================================================
// RND Screen Generator — Supabase Render Read Model
// ============================================================
//
// Status:
//   Active reference for the relational render_* Supabase read model.
//   Existing non-render tables may remain alive until a dedicated drop migration,
//   but current app/package runtime should not consume them.
//
// Goal:
//   Persist accepted local generation results in a relational shape that can be
//   loaded into @cx/adapters/table and rebuilt as RenderTreeScreenNode.
//
// Source shape:
//   data/tables/screen_routes.json
//   data/tables/screen_variants.json
//   data/tables/screens.json
//   data/tables/areas.json
//   data/tables/components.json
//
// Design rule:
//   Do not hide parent/child structure, ordering, screen regions, or layout refs
//   inside JSONB. JSONB is allowed only for bounded payload fields whose shape
//   is owned by component/catalog contracts, such as props, hook payload, and
//   display hints.
//
// Naming:
//   CX component definitions are owned by @cx/components/catalog. DB rows do
//   not redefine those definitions. The DB stores components and ordered
//   render_component_children that reference catalog component type keys.
// ============================================================

Project rnd_screen_generator_render_read_model {
  database_type: 'PostgreSQL'
  Note: '''
    Local inference remains the authoring flow:

      Markdown/local inference
      -> final-result.json
      -> data/tables/*.json
      -> DB upsert
      -> DB read
      -> @cx/adapters/table
      -> RenderTreeScreenNode
      -> @cx/renderer / workbench

    This schema models screen, region, area, component, and child ordering as
    relational rows. It intentionally avoids the previous render_* mirror shape
    that kept screen/area/component children in nested JSONB.
  '''
}

Enum render_screen_variant_type {
  base
  edge
}

Enum render_screen_type {
  page
  bottomsheet
  popup
}

Enum render_screen_region_type {
  header
  contents
  bottom
}

Enum render_area_type {
  area_static
  area_dynamic
}

// ============================================================
// Route grouping for navigation/module/process rails.
// Local source: screen_routes.json screenRoutes[].
// ============================================================
Table render_screen_routes {
  id          varchar     [pk]
  module_id   varchar     [null, note: "local moduleId"]
  process_id  varchar     [null, note: "local processId"]
  name        varchar     [not null]
  order_index integer     [not null, note: "local order"]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    (module_id, order_index, id)
    (process_id)
  }
}

// ============================================================
// Variant grouping inside a route.
// Local source: screen_variants.json screenVariants[].
// ============================================================
Table render_screen_variants {
  id              varchar             [pk]
  screen_route_id varchar             [not null, ref: > render_screen_routes.id]
  name            varchar             [not null]
  order_index     integer             [not null, note: "local order"]
  type            render_screen_variant_type [not null, default: 'base']
  created_at      timestamptz         [not null, default: `now()`]
  updated_at      timestamptz         [not null, default: `now()`]

  indexes {
    (screen_route_id, order_index, id)
    (type)
  }
}

// ============================================================
// Screen shell record.
// Local source: screens.json screens[] except screen.regions.
// ============================================================
Table render_screens {
  id                   varchar     [pk]
  screen_variant_id    varchar     [not null, ref: > render_screen_variants.id]
  version              varchar     [not null, default: '0.1.0']
  type                 render_screen_type [not null, default: 'page']
  layout_id            varchar     [not null, note: "layout.screen.*"]
  order_index          integer     [not null, default: 0, note: "local order when present"]
  name                 text        [not null]
  description          text        [null]
  author               varchar     [null]
  created_at           timestamptz [not null, default: `now()`]
  updated_at           timestamptz [not null, default: `now()`]

  indexes {
    (screen_variant_id, order_index, id)
    (layout_id)
  }
}

// ============================================================
// One row per screen rail.
// Local source: screens[].screen.regions.header/contents/bottom.
// ============================================================
Table render_screen_regions {
  id          varchar            [pk, note: "recommended ${screen_id}.${type}"]
  screen_id   varchar            [not null, ref: > render_screens.id]
  type        render_screen_region_type [not null, note: "maps to RenderTree Screen.Header/Screen.Contents/Screen.Bottom"]
  layout_id   varchar            [not null, note: "layout.region.*"]
  created_at  timestamptz        [not null, default: `now()`]
  updated_at  timestamptz        [not null, default: `now()`]

  indexes {
    (screen_id, type) [unique]
    (layout_id)
  }

  Note: '''
    Region row type is the only region node type source. @cx/adapters/table maps
    header/contents/bottom to RenderTree Screen.Header/Screen.Contents/
    Screen.Bottom node types and derives region order from type.
  '''
}

// ============================================================
// Ordered children inside a screen region.
// Local source: region.children[].
// ============================================================
Table render_screen_region_children {
  id               uuid        [pk, default: `gen_random_uuid()`]
  screen_region_id varchar     [not null, ref: > render_screen_regions.id]
  area_id          varchar     [not null, ref: > render_areas.id]
  order_index      integer     [not null]
  created_at       timestamptz [not null, default: `now()`]

  indexes {
    (screen_region_id, order_index) [unique]
    (area_id)
  }

  Note: '''
    Screen regions always point to area rows. Even header AppBar rows are
    normalized as:

      Screen.Header -> area -> component(AppBar)

    Direct region -> component shortcuts are not part of this schema.
  '''
}

// ============================================================
// Area wrapper record.
// Local source: areas.json areas[] except children.
// ============================================================
Table render_areas {
  id          varchar     [pk]
  type        render_area_type   [not null, note: "area.static -> area_static, area.dynamic -> area_dynamic"]
  version     varchar     [not null, default: '0.1.0']
  layout_id   varchar     [not null, note: "layout.area.*"]
  name        text        [not null]
  description text        [null]
  author      varchar     [null]
  props       jsonb       [null, note: "bounded area payload; no child refs"]
  created_at  timestamptz [not null, default: `now()`]
  updated_at  timestamptz [not null, default: `now()`]

  indexes {
    (layout_id)
    (type)
  }
}

// ============================================================
// Ordered children inside an area.
// Local source: areas[].children[].
// ============================================================
Table render_area_children {
  id           uuid        [pk, default: `gen_random_uuid()`]
  area_id      varchar     [not null, ref: > render_areas.id]
  component_id varchar     [not null, ref: > render_components.id]
  order_index  integer     [not null]
  created_at   timestamptz [not null, default: `now()`]

  indexes {
    (area_id, order_index) [unique]
    (component_id)
  }

  Note: '''
    Current local data has no area-under-area relation. All area children are
    component refs, so this table intentionally does not carry child_kind or
    child_area_id. Add a separate relation only if the local table contract
    introduces nested areas under areas.
  '''
}

// ============================================================
// Component record.
// Local source: components.json components[].
// A component is the DB renderable unit placed under an area.
// It contains one or more ordered catalog component references in
// render_component_children.
// ============================================================
Table render_components {
  id                varchar     [pk]
  type              varchar     [not null, note: "local components[].type"]
  version           varchar     [not null, default: '0.1.0']
  layout_id         varchar     [not null, note: "layout.composite.*"]
  name              text        [not null]
  description       text        [null]
  author            varchar     [null]
  display           jsonb       [null, note: "bounded display/state hints only"]
  hooks             jsonb       [null, note: "NodeHook[] interaction contract; e.g. trigger/action/target/payload"]
  created_at        timestamptz [not null, default: `now()`]
  updated_at        timestamptz [not null, default: `now()`]

  indexes {
    (type)
    (layout_id)
  }

  Note: '''
    This row does not redefine @cx/components catalog entries. Its children
    reference catalog component types through render_component_children. Current local
    data has one child per component row, but the schema supports ordered
    combinations without adding a separate composite table.
  '''
}

// ============================================================
// Ordered catalog component references inside a component.
// Local source: components[].children[].
// ============================================================
Table render_component_children {
  id                     uuid        [pk, default: `gen_random_uuid()`]
  component_id           varchar     [not null, ref: > render_components.id]
  order_index            integer     [not null]
  catalog_component_type varchar     [not null, note: "child.component.type; lookup in @cx/components/catalog"]
  variant                varchar     [null, note: "reserved for child.component.variant when introduced"]
  props                  jsonb       [null, note: "catalog component props payload"]
  created_at             timestamptz [not null, default: `now()`]
  updated_at             timestamptz [not null, default: `now()`]

  indexes {
    (component_id, order_index) [unique]
    (catalog_component_type)
  }

  Note: '''
    One row means the component renders one catalog component. Multiple rows
    mean it renders an ordered catalog component composition. Catalog details
    are read from @cx/components/catalog, not stored here.
  '''
}
