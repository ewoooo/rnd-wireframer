  "screenIntent": {
    "schemaVersion": "screen-intent.v0.1",
    "screenPurpose": "사용자가 상품 담기에 실패한 사유(상품·옵션·조건·정책 축 중 어디서 막혔는지)를 이해하고, 중복가입 및 그룹상품 구성 검증 결과를 확인한 뒤 복구 경로로 진행하거나 나중에 다시 보기를 선택할 수 있도록 안내한다.",
    "primaryUserAction": "실패 사유와 검증 결과를 확인한 후 하단 '계속하기' CTA로 복구 흐름을 진행한다.",
    "primaryTask": "담기 실패 원인 파악 및 복구 경로 진입",
    "audience": "상품 조합·중복가입·정책 충돌로 담기에 실패한 가입 시도 고객",
    "successMoment": "고객이 실패축과 해결 방법을 인지하고 '계속하기'로 복구 경로에 진입하거나 '나중에 다시 보기'로 상태를 저장한 순간",
    "contentPriority": [
      "CalloutFailReason",
      "TitleSectionFailReason",
      "ListTextDuplicateCheck",
      "ListSelectedGroupProduct",
      "TitleSectionComboResult",
      "ActionButtonRecover",
      "TextButtonViewLater",
      "AppBarHeader"
    ],
    "sourceInterpretation": {
      "preserve": [
        "CalloutFailReason의 실패축({실패축})과 해결 방법 문구",
        "ListTextDuplicateCheck의 중복가입판정결과 바인딩",
        "ListSelectedGroupProduct의 그룹상품명 라디오 선택",
        "ActionButtonRecover '계속하기' CTA 및 원위치 복귀 의미",
        "정책 참조 PI-PRDD-FAIL-001-01/02/03/04, PI-PRDD-COMBO-001-02/03, PI-PRDD-OPTION-001-03"
      ],
      "summarize": [
        "TitleSectionFailReason 및 TitleSectionComboResult 섹션 제목은 영역 맥락 제공용으로 간결 유지",
        "AppBarHeader는 화면 식별을 위한 상단 네비 라벨"
      ],
      "defer": [
        "TextButtonViewLater(나중에 다시 보기)는 보조 행동으로 주 CTA 이후 처리",
        "errorPolicy(영역 전체 숨김/오류 항목 미노출) 같은 영역 메타는 상태 처리 단계에서 반영"
      ]
    },
    "rationale": "소스 스펙은 '선택 불가·충돌 사유 안내' 화면으로, contents 영역에 실패 사유 안내(Callout)와 검증 결과(중복가입/그룹상품 구성)가 각각 dynamic area로 배치되고 bottom에 복구 CTA가 단독으로 존재한다. 따라서 사용자가 먼저 실패축을 이해(Callout)하고, 구체 검증 결과를 확인한 뒤, 복구 CTA로 행동하는 흐름이 핵심 의도다. 정책 참조(PI-PRDD-FAIL-001-*, COMBO-001-*)와 API 바인딩(FN-PRDD-FAIL-001, FN-PRDD-COMBO-001)이 해당 우선순위를 뒷받침한다.",
    "missingDecisions": [
      "{실패축} 값이 다중일 때 Callout 복수 표기 여부",
      "중복가입 불가 판정 시 ActionButtonRecover의 활성/비활성 정책",
      "ListSelectedGroupProduct에서 그룹 미선택 상태의 CTA 게이팅 규칙",
      "TextButtonViewLater 실행 후 화면 전이 또는 토스트 표현 방식"
    ],
    "stateCoverageHints": [
      {
        "surface": "detail",
        "states": [
          "populated",
          "error",
          "empty"
        ],
        "reason": "실패 사유 Callout과 검증 결과는 api:FN-PRDD-FAIL-001 / FN-PRDD-COMBO-001 응답 기반이며 errorPolicy가 '영역 전체 숨김' 또는 '오류 항목 미노출'로 정의되어 있어 정상/오류/빈 항목 분기가 필요"
      },
      {
        "surface": "async",
        "states": [
          "loading",
          "error"
        ],
        "reason": "두 dynamic area 모두 외부 API 바인딩이므로 로딩 및 실패 상태 표현 필요"
      },
      {
        "surface": "form",
        "states": [
          "validation",
          "disabled"
        ],
        "reason": "ListSelectedGroupProduct의 라디오 선택과 중복가입 판정에 따라 ActionButtonRecover의 유효성/비활성 처리가 필요"
      }
    ],
