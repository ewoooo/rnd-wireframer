{
  "version": "render-tree.v0.1",
  "metadata": {
    "id": "screen.failReasonGuide",
    "description": "선택 불가·충돌 사유 안내 화면 — 실패 사유 Callout, 검증 결과 리스트, 복구 CTA"
  },
  "children": [
    {
      "type": "Screen",
      "componentVersion": "1.0.0",
      "metadata": {
        "id": "screen.failReasonGuide",
        "title": "선택 불가·충돌 사유 안내"
      },
      "layout": "layout.screen.screenShell",
      "children": [
        {
          "type": "Screen.Header",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region.header",
            "title": "헤더"
          },
          "layout": "layout.region.header",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area.header.appBar",
                "title": "앱바 헤더"
              },
              "layout": "layout.area.areaAppBar",
              "children": [
                {
                  "type": "AppBar",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.appBarHeader",
                    "title": "AppBarHeader"
                  },
                  "layout": "layout.composite.componentAppBar",
                  "props": {
                    "title": "선택 불가·충돌 사유 안내",
                    "showBack": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Contents",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region.contents",
            "title": "콘텐츠"
          },
          "layout": "layout.region.contents",
          "children": [
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area.contents.feedback",
                "title": "실패 사유 메시지 스택",
                "description": "sourceAreaId=1, errorPolicy=영역 전체 숨김"
              },
              "layout": "layout.area.fieldStack",
              "props": {
                "usedFor": "메시지 스택",
                "divider": "section"
              },
              "display": {
                "when": {
                  "bind": "api.FN-PRDD-FAIL-001.visible",
                  "default": true
                },
                "stateRole": "base"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.titleSectionFailReason",
                    "title": "TitleSectionFailReason"
                  },
                  "layout": "layout.composite.componentTitleSection",
                  "props": {
                    "title": "담기에 실패한 이유를 확인해 주세요"
                  }
                },
                {
                  "type": "Callout",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.calloutFailReason",
                    "title": "CalloutFailReason"
                  },
                  "layout": "layout.composite.componentSectionMessage",
                  "props": {
                    "title": {
                      "bind": "api.FN-PRDD-FAIL-001.failAxis",
                      "default": "{실패축}"
                    },
                    "children": {
                      "bind": "api.FN-PRDD-FAIL-001.resolutionMessage",
                      "default": "해결 방법을 확인하고 다음 단계로 진행해 주세요."
                    }
                  }
                },
                {
                  "type": "TextButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.textButtonViewLater",
                    "title": "TextButtonViewLater"
                  },
                  "layout": "layout.composite.componentTextButton",
                  "props": {
                    "label": "나중에 다시 보기",
                    "underline": true
                  }
                }
              ]
            },
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area.contents.validationList",
                "title": "검증 결과 리스트 스택",
                "description": "sourceAreaId=2, errorPolicy=오류 항목 미노출"
              },
              "layout": "layout.area.listStack",
              "props": {
                "divider": "contents",
                "itemTemplate": "default-20"
              },
              "display": {
                "when": {
                  "bind": "api.FN-PRDD-COMBO-001.visible",
                  "default": true
                },
                "stateRole": "base"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.titleSectionComboResult",
                    "title": "TitleSectionComboResult"
                  },
                  "layout": "layout.composite.componentTitleSection",
                  "props": {
                    "title": "검증 결과"
                  }
                },
                {
                  "type": "ListText",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.listTextDuplicateCheck",
                    "title": "ListTextDuplicateCheck"
                  },
                  "layout": "layout.composite.componentListText",
                  "props": {
                    "table": "firstTitle",
                    "title": "중복가입 판정",
                    "subText": {
                      "bind": "api.FN-PRDD-COMBO-001.duplicateCheckResult",
                      "default": "확인 중"
                    }
                  },
                  "display": {
                    "when": {
                      "bind": "api.FN-PRDD-COMBO-001.duplicateCheck.ok",
                      "default": true
                    }
                  }
                },
                {
                  "type": "ListSelected",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.listSelectedGroupProduct",
                    "title": "ListSelectedGroupProduct"
                  },
                  "layout": "layout.composite.componentListCell",
                  "props": {
                    "type": "radio",
                    "label": {
                      "bind": "api.FN-PRDD-COMBO-001.groupProductName",
                      "default": "그룹상품 선택"
                    },
                    "checked": {
                      "bind": "state.groupProduct.selected",
                      "default": false
                    },
                    "showPrice": false,
                    "showButton": false
                  },
                  "display": {
                    "when": {
                      "bind": "api.FN-PRDD-COMBO-001.groupProduct.ok",
                      "default": true
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Bottom",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region.bottom",
            "title": "하단"
          },
          "layout": "layout.region.bottom",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area.bottom.cta",
                "title": "하단 액션 영역"
              },
              "layout": "layout.area.bottomActionArea",
              "children": [
                {
                  "type": "ActionButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "comp.actionButtonRecover",
                    "title": "ActionButtonRecover"
                  },
                  "layout": "layout.composite.componentActionButton",
                  "props": {
                    "type": "Default",
                    "button": "1",
                    "primaryText": "계속하기"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
