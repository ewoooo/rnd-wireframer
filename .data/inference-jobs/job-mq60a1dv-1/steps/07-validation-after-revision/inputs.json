  "screenIntent": {
    "schemaVersion": "screen-intent.v0.1",
    "screenPurpose": "상품 담기에 실패한 사용자에게 실패 사유(상품·옵션·조건·정책 축)와 선택 구성 검증 결과를 명확히 안내하여 복구 경로로 이어주는 화면",
    "primaryUserAction": "실패 사유와 검증 결과를 확인한 뒤 하단 '계속하기' CTA로 복구 흐름을 이어가기",
    "primaryTask": "선택 조합 충돌·중복가입 등 담기 실패 원인을 이해하고 수정 방법을 결정",
    "audience": "상품 담기 과정에서 조합 충돌 또는 가입 조건 위반으로 실패를 경험한 사용자",
    "successMoment": "실패 축과 수정 방법을 인지하고 '계속하기'로 복구 흐름에 진입하는 순간",
    "contentPriority": [
      "CalloutFailReason",
      "TitleSectionFailReason",
      "ListTextDuplicateCheck",
      "ListSelectedGroupProduct",
      "TitleSectionComboResult",
      "ActionButtonRecover",
      "TextButtonViewLater"
    ],
    "sourceInterpretation": {
      "preserve": [
        "CalloutFailReason: 실패축({실패축}) 및 수정 방법 안내 (api:FN-PRDD-FAIL-001)",
        "ListTextDuplicateCheck: 중복가입 가능여부 판정 결과 (api:FN-PRDD-COMBO-001)",
        "ListSelectedGroupProduct: 그룹상품 구성 상태 표시 (api:FN-PRDD-COMBO-001)",
        "ActionButtonRecover: '계속하기' 복구 CTA (api:FN-PRDD-FAIL-001)",
        "정책 PI-PRDD-FAIL-001-01/02/03/04 및 PI-PRDD-COMBO-001-02/03, PI-PRDD-OPTION-001-03 준수"
      ],
      "summarize": [
        "TitleSectionFailReason 및 TitleSectionComboResult는 섹션 진입 단서로 압축",
        "AppBarHeader는 '선택 불가·충돌 사유 안내' 컨텍스트 단서로만 활용"
      ],
      "defer": [
        "TextButtonViewLater(나중에 다시 보기) - viewLaterSaved 상태 기반 보조 행동으로 후순위",
        "errorPolicy 영역 전체 숨김/오류 항목 미노출 규칙은 렌더 단계에서 해석"
      ]
    },
    "missingDecisions": [
      "{실패축} 토큰의 실제 enum 값과 표시 라벨 매핑",
      "중복가입판정결과의 가능한 상태값(가능/불가/조건부)과 각 상태별 부가 안내 문구",
      "TextButtonViewLater 탭 시 저장 동작/피드백 사양",
      "ActionButtonRecover '계속하기'의 다음 라우트 및 실패 축별 분기 여부"
    ],
    "stateCoverageHints": [
      {
        "surface": "async",
        "states": [
          "loading",
          "error",
          "populated"
        ],
        "reason": "FN-PRDD-FAIL-001 및 FN-PRDD-COMBO-001 API 응답에 따라 Callout과 List 결과가 채워지며, errorPolicy(영역 전체 숨김/오류 항목 미노출)에 따른 분기 표현 필요"
      },
      {
        "surface": "detail",
        "states": [
          "populated",
          "empty"
        ],
        "reason": "검증 결과 영역(maxCount=N, minCount=0)이 비어있는 경우와 채워진 경우 모두 표현 필요"
      },
      {
        "surface": "form",
        "states": [
          "disabled",
          "validation"
        ],
        "reason": "그룹상품 라디오 선택 및 '계속하기' CTA는 검증 통과 여부에 따라 비활성/검증 안내 상태가 필요"
      }
    ],
    "rationale": "소스 스펙의 영역 1(실패 사유 안내, errorPolicy='영역 전체 숨김')과 영역 2(선택 구성 검증 결과)가 화면의 두 축으로, Callout이 실패 원인을 축 단위로 요약하고 List 컴포넌트들이 구체 검증 결과를 보여준 뒤 하단 ActionButton이 복구 행동을 제공한다. 따라서 'why failed → what's wrong → how to recover' 순으로 콘텐츠 우선순위를 구성하고, 정책 노트(PI-PRDD-FAIL-001-*, PI-PRDD-COMBO-001-*)에 명시된 안내·복귀 경로를 보존 대상으로 지정한다.",
