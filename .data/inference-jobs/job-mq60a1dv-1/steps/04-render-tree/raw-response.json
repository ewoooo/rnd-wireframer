{
  "version": "render-tree.v0.1",
  "metadata": {
    "id": "rt-prdd-fail-recover",
    "description": "상품 담기 실패 사유 안내 및 검증 결과 복구 화면"
  },
  "children": [
    {
      "type": "Screen",
      "componentVersion": "1.0.0",
      "metadata": {
        "id": "screen-fail-recover",
        "title": "담기 실패 안내"
      },
      "layout": "layout.screen.screenShell",
      "children": [
        {
          "type": "Screen.Header",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-header",
            "title": "헤더"
          },
          "layout": "layout.region.header",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-appbar",
                "title": "앱바 영역"
              },
              "layout": "layout.area.areaAppBar",
              "children": [
                {
                  "type": "AppBar",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "appbar-header",
                    "title": "앱바",
                    "description": "선택 불가·충돌 사유 안내 컨텍스트"
                  },
                  "props": {
                    "title": "담기 실패",
                    "showBack": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Contents",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-contents",
            "title": "콘텐츠"
          },
          "layout": "layout.region.contents",
          "children": [
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-feedback",
                "title": "실패 사유 안내",
                "description": "Why failed - Callout 중심 메시지 스택"
              },
              "layout": "layout.area.fieldStack",
              "display": {
                "when": {
                  "bind": "feedback.visible",
                  "default": true
                },
                "stateRole": "base"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "title-fail-reason",
                    "title": "실패 사유 섹션 타이틀"
                  },
                  "props": {
                    "title": "담기를 완료하지 못했어요",
                    "subtitle": "아래 사유를 확인해 주세요"
                  }
                },
                {
                  "type": "Callout",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "callout-fail-reason",
                    "title": "실패 사유 Callout",
                    "description": "FN-PRDD-FAIL-001 실패축 안내"
                  },
                  "props": {
                    "title": {
                      "bind": "failReason.title",
                      "default": "선택하신 구성에 충돌이 있습니다"
                    },
                    "children": {
                      "bind": "failReason.message",
                      "default": "실패축({실패축})에 따라 수정이 필요합니다."
                    }
                  }
                },
                {
                  "type": "TextButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "textbutton-view-later",
                    "title": "나중에 다시 보기",
                    "description": "viewLaterSaved 상태 기반 보조 행동"
                  },
                  "display": {
                    "when": {
                      "bind": "viewLaterAvailable",
                      "default": true
                    }
                  },
                  "props": {
                    "label": "나중에 다시 보기",
                    "underline": true
                  }
                }
              ]
            },
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-validation-result",
                "title": "선택 구성 검증 결과",
                "description": "What's wrong - 행 단위 검증 결과"
              },
              "layout": "layout.area.listStack",
              "display": {
                "when": {
                  "bind": "validation.hasItems",
                  "default": true
                },
                "stateRole": "base"
              },
              "props": {
                "divider": "contents"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "title-combo-result",
                    "title": "검증 결과 섹션 타이틀"
                  },
                  "props": {
                    "title": "선택 구성 검증 결과",
                    "subtitle": "충돌 항목을 확인해 주세요"
                  }
                },
                {
                  "type": "ListText",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "listtext-duplicate-check",
                    "title": "중복가입 가능여부",
                    "description": "FN-PRDD-COMBO-001 중복가입 판정 결과"
                  },
                  "display": {
                    "when": {
                      "bind": "duplicateCheck.visible",
                      "default": true
                    }
                  },
                  "props": {
                    "table": "firstTitle",
                    "title": "중복가입 가능여부",
                    "subText": {
                      "bind": "duplicateCheck.status",
                      "default": "확인 필요"
                    }
                  }
                },
                {
                  "type": "ListSelected",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "listselected-group-product",
                    "title": "그룹상품 구성",
                    "description": "FN-PRDD-COMBO-001 그룹상품 구성 상태"
                  },
                  "display": {
                    "when": {
                      "bind": "groupProduct.visible",
                      "default": true
                    },
                    "stateRole": "base"
                  },
                  "props": {
                    "type": "radio",
                    "label": {
                      "bind": "groupProduct.label",
                      "default": "그룹상품 구성"
                    },
                    "checked": {
                      "bind": "groupProduct.checked",
                      "default": false
                    },
                    "showPrice": false,
                    "showButton": false
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Bottom",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-bottom",
            "title": "하단"
          },
          "layout": "layout.region.bottom",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-bottom-action",
                "title": "복구 CTA 영역",
                "description": "How to recover - sticky 하단 CTA"
              },
              "layout": "layout.area.bottomActionArea",
              "children": [
                {
                  "type": "ActionButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "action-recover",
                    "title": "계속하기",
                    "description": "FN-PRDD-FAIL-001 복구 CTA"
                  },
                  "display": {
                    "stateRole": "base"
                  },
                  "props": {
                    "type": "Default",
                    "button": "1",
                    "primaryText": "계속하기"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
