{
  "compositionPlan": {
    "schemaVersion": "composition-plan.v0.1",
    "screenLayout": "layout.screen.screenShell",
    "layoutStrategy": "Header에 AppBar 단일 슬롯, Contents에 두 개의 동적 area(실패 사유 안내 → 검증 결과)를 세로 스택으로 배치, Bottom에 단일 복구 CTA를 고정하는 3-region 셸 구조. 진단(원인) → 검증 세부 → 복구 행동 순으로 시선이 내려가도록 한다.",
    "sections": [
      {
        "targetRegion": "header",
        "role": "header",
        "priority": 1,
        "sourceRefs": [
          "AppBarHeader"
        ],
        "strategy": "layout.area.areaAppBar에 AppBar(WithBack) 단일 컴포넌트를 배치해 화면 식별과 뒤로가기 내비게이션을 제공"
      },
      {
        "targetRegion": "contents",
        "role": "feedback",
        "priority": 2,
        "sourceRefs": [
          "TitleSectionFailReason",
          "CalloutFailReason",
          "TextButtonViewLater"
        ],
        "strategy": "layout.area.areaVertical에 TitleSection(섹션 제목) → Callout(WithTitle, 실패축/해결 방법) → TextButton(나중에 다시 보기) 순으로 세로 배치. errorPolicy='영역 전체 숨김'을 area visibility로 매핑하고 Callout을 본 화면의 진입점 메시지로 강조"
      },
      {
        "targetRegion": "contents",
        "role": "content",
        "priority": 3,
        "sourceRefs": [
          "TitleSectionComboResult",
          "ListTextDuplicateCheck",
          "ListSelectedGroupProduct"
        ],
        "strategy": "layout.area.listStack(divider=contents)에 TitleSection → ListText(중복가입 가능여부) → ListSelected(그룹상품 radio) 순으로 배치. 검증 결과의 항목 간 1px 디바이더로 행 구분, minCount=0일 때 area 자체 숨김 처리"
      },
      {
        "targetRegion": "bottom",
        "role": "bottom-action",
        "priority": 4,
        "sourceRefs": [
          "ActionButtonRecover"
        ],
        "strategy": "layout.area.bottomActionArea에 ActionButton(default, '계속하기') 단일 CTA를 고정해 복구 흐름 진입점을 제공"
      }
    ],
    "visualHierarchy": "1) Callout(실패축 안내)이 가장 강한 시각 무게로 사용자 이해의 진입점이 된다. 2) 검증 결과 리스트는 보조 진단 정보로 그 다음 강조. 3) 하단 ActionButton이 종착 행동으로 sticky 고정되어 명확한 다음 단계를 제시. 4) TextButtonViewLater는 inline 보조 행동으로 약하게 표현해 안전 이탈 경로를 제공.",
    "primaryUserAction": "CalloutFailReason으로 실패 축과 해결 방법을 확인한 뒤 ActionButtonRecover(계속하기)로 복구 흐름에 진입한다.",
    "sectionRhythm": "Header(고정) → Contents 영역1(피드백/진단: 제목·Callout·보조 링크) → Contents 영역2(검증 결과 리스트, divider 구분) → Bottom(고정 CTA). 영역 간 section break, 리스트 내부는 1px contents divider로 리듬 차등화.",
    "density": "medium",
    "patternRationale": "소스가 header/contents/bottom의 표준 3-region 구조이며 특수한 상품 상세/카드 리스트 셸 특성이 없으므로 가장 일반적인 layout.screen.screenShell이 적합. Contents의 두 동적 area는 (1) 피드백/안내 성격 → areaVertical, (2) 행 항목 반복 비교 성격 → listStack(divider=contents)로 분리해 의도(이해 vs 진단 비교)를 시각 패턴으로 구분. Bottom 단일 CTA는 bottomActionArea가 정확히 일치.",
    "rejectedPatterns": [
      {
        "pattern": "layout.screen.commerceDetailScreen",
        "reason": "상품 hero/옵션 그리드/고지 아코디언 구조가 아니며, 본 화면은 진단·복구 안내가 목적이라 상품 상세 셸의 sticky bottom + scrollable detail rhythm이 과한 구조"
      },
      {
        "pattern": "layout.screen.textListScreen",
        "reason": "요약 카드 + 필터/리스트 반복 패턴이 아님. 두 area는 의미가 다른 묶음이라 단일 텍스트 리스트 셸로 환원되지 않음"
      },
      {
        "pattern": "layout.screen.cardListScreen",
        "reason": "상품 card 반복 리스트가 아니며 chip/filter/sort 제어가 없음"
      },
      {
        "pattern": "layout.area.accordionList",
        "reason": "검증 결과 항목이 펼침/접힘 disclosure가 아니라 항상 노출되는 라벨-값/선택 row이므로 listStack(divider=contents)가 더 적합"
      },
      {
        "pattern": "layout.area.fieldStack",
        "reason": "입력 필드 묶음이 아니라 안내·결과 표시 영역이라 의미 매칭이 어긋남"
      }
    ]
  },
  "renderTree": {
