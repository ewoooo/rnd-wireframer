  "screenIntent": {
    "schemaVersion": "screen-intent.v0.1",
    "screenPurpose": "담기 실패 사유(상품·옵션·조건·정책 축)와 중복가입/그룹 구성 검증 결과를 한 화면에서 안내하여 사용자가 원인을 이해하고 복구 행동을 이어가도록 한다.",
    "primaryUserAction": "CalloutFailReason으로 실패 축과 해결 방법을 확인한 뒤 ActionButtonRecover(계속하기)로 복구 흐름을 이어간다.",
    "primaryTask": "선택 조합 충돌·중복가입 불가 상황을 진단하고 복구 경로로 진입",
    "audience": "상품 담기 과정에서 선택 조합 충돌 또는 중복가입 제한에 부딪힌 가입 진행 고객",
    "successMoment": "사용자가 실패 사유를 이해하고 ActionButtonRecover로 복구 경로에 진입하거나 TextButtonViewLater로 나중에 다시 보기로 안전 이탈한다.",
    "contentPriority": [
      "AppBarHeader",
      "TitleSectionFailReason",
      "CalloutFailReason",
      "TitleSectionComboResult",
      "ListTextDuplicateCheck",
      "ListSelectedGroupProduct",
      "TextButtonViewLater",
      "ActionButtonRecover"
    ],
    "sourceInterpretation": {
      "preserve": [
        "CalloutFailReason title/body의 실패축·수정 방법 안내 문구",
        "ListTextDuplicateCheck의 중복가입 가능여부 판정 결과",
        "ListSelectedGroupProduct의 그룹상품 선택 구성",
        "ActionButtonRecover '계속하기' CTA",
        "TextButtonViewLater '나중에 다시 보기' 보조 행동"
      ],
      "summarize": [
        "TitleSectionFailReason과 TitleSectionComboResult의 섹션 제목 역할",
        "AppBarHeader의 화면 식별/뒤로가기 내비게이션"
      ],
      "defer": [
        "[정책:PI-PRDD-FAIL-001-01/02/03/04], [정책:PI-PRDD-COMBO-001-02/03], [정책:PI-PRDD-OPTION-001-03], [정책:PI-PRDD-ELIG-001-02] 정책 세부 텍스트는 본 단계가 아닌 후속 단계에서 바인딩",
        "api:FN-PRDD-FAIL-001 및 api:FN-PRDD-COMBO-001의 실시간 페이로드 스키마 결정"
      ]
    },
    "rationale": "소스의 contents 슬롯이 (1) 실패 사유 안내 영역과 (2) 검증 결과 영역 두 동적 영역으로 나뉘며, bottom 슬롯의 ActionButtonRecover가 단일 주 CTA이다. 따라서 화면 목적은 '실패 진단 + 복구 진입'이며, Callout이 사용자 이해의 진입점, ActionButton이 복구 행동의 종점이 된다. 그룹상품/중복가입 결과는 보조 진단 정보로 그 다음 우선순위를 가진다.",
    "missingDecisions": [
      "{실패축}, {중복가입판정결과}, {그룹상품명} 동적 바인딩 값의 후보 enum과 fallback 문구",
      "ActionButtonRecover '계속하기' 클릭 시 복귀할 목적지 라우트(원위치 복귀 정보의 구체 경로)",
      "TextButtonViewLater 저장 후 사용자에게 줄 confirmation 피드백 형태(토스트/모달)",
      "Area 2(검증 결과)가 minCount=0일 때 Area 1만으로 화면이 충분한지 여부"
    ],
    "stateCoverageHints": [
