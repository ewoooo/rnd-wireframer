  "screenIntent": {
    "schemaVersion": "screen-intent.v0.1",
    "screenPurpose": "사용자가 상품 담기에 실패한 이유(상품·옵션·조건·정책 충돌)를 명확히 이해하고, 선택 구성 검증 결과를 검토하여 복구 행동을 이어가도록 안내한다.",
    "primaryUserAction": "CalloutFailReason에서 실패 사유를 확인한 뒤 ActionButtonRecover('계속하기')로 복구 흐름을 진행한다.",
    "primaryTask": "담기 실패 사유 파악 및 선택 구성 복구",
    "audience": "상품 담기를 시도했으나 조합·중복가입·정책 충돌로 실패한 가입 진행 중인 사용자",
    "successMoment": "사용자가 실패 축과 해결 방법을 인지하고 '계속하기'로 복구 경로에 진입하는 순간",
    "contentPriority": [
      "TitleSectionFailReason",
      "CalloutFailReason",
      "TitleSectionComboResult",
      "ListTextDuplicateCheck",
      "ListSelectedGroupProduct",
      "TextButtonViewLater",
      "ActionButtonRecover"
    ],
    "sourceInterpretation": {
      "preserve": [
        "CalloutFailReason 실패축/해결방법 안내 문구",
        "ListTextDuplicateCheck 중복가입 판정 결과",
        "ListSelectedGroupProduct 그룹상품 선택 상태",
        "ActionButtonRecover 복구 CTA",
        "TextButtonViewLater 대체 경로"
      ],
      "summarize": [
        "AppBarHeader 상단 타이틀",
        "TitleSection 섹션 제목들"
      ],
      "defer": [
        "정책 식별자(PI-PRDD-*) 상세 노출",
        "api:FN-PRDD-* 바인딩 메타데이터"
      ]
    },
    "rationale": "소스의 contents 영역 1은 실패 사유 안내(주 메시지), 영역 2는 충돌·중복가입 검증 결과(증빙), bottom은 복구 CTA로 구성되어 있어 '원인 인지 → 검증 확인 → 복구 행동' 순서가 사용자의 의사결정 흐름과 일치한다. errorPolicy('영역 전체 숨김','오류 항목 미노출')와 dynamic area maxCount 정의는 상태별 분기를 요구한다.",
    "missingDecisions": [
      "실패축({실패축}) 토큰의 구체 값 매핑 규칙",
      "중복가입판정결과 텍스트 변형(가능/불가/제한) 처리",
      "viewLaterSaved state의 토글 후 후속 화면 경로",
      "ActionButtonRecover 후 복구 대상 화면 라우팅"
    ],
    "stateCoverageHints": [
      {
        "surface": "async",
        "states": [
          "loading",
          "error",
          "populated"
        ],
        "reason": "FN-PRDD-FAIL-001 및 FN-PRDD-COMBO-001 비동기 호출 결과에 따라 Callout과 검증 리스트가 채워진다."
      },
      {
        "surface": "detail",
        "states": [
          "empty",
          "populated",
          "error"
        ],
        "reason": "area 1은 errorPolicy '영역 전체 숨김', area 2는 '오류 항목 미노출'로 데이터 부재/오류 시 분기 필요."
      },
      {
        "surface": "form",
        "states": [
          "disabled",
          "validation"
        ],
        "reason": "ListSelectedGroupProduct radio 선택과 ActionButtonRecover 활성화 여부가 검증 결과에 종속된다."
      }
    ],
