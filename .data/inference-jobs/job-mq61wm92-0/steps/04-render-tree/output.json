{
  "version": "render-tree.v0.1",
  "metadata": {
    "id": "screen-cart-fail-recovery",
    "description": "상품 담기 실패 사유 안내 및 복구 화면"
  },
  "children": [
    {
      "type": "Screen",
      "componentVersion": "1.0.0",
      "metadata": {
        "id": "screen-root",
        "title": "담기 실패 안내"
      },
      "layout": "layout.screen.screenShell",
      "children": [
        {
          "type": "Screen.Header",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-header",
            "title": "헤더"
          },
          "layout": "layout.region.header",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-appbar",
                "title": "앱바 영역"
              },
              "layout": "layout.area.areaAppBar",
              "children": [
                {
                  "type": "AppBar",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "appbar-header",
                    "title": "AppBar"
                  },
                  "props": {
                    "title": "담기 실패",
                    "showBack": true
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Contents",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-contents",
            "title": "콘텐츠"
          },
          "layout": "layout.region.contents",
          "children": [
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-fail-reason",
                "title": "실패 사유 메시지 스택"
              },
              "layout": "layout.area.fieldStack",
              "display": {
                "when": {
                  "bind": "failReason.visible",
                  "default": true
                },
                "stateRole": "base"
              },
              "props": {
                "divider": "section"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "title-fail-reason",
                    "title": "실패 사유 제목"
                  },
                  "props": {
                    "title": "담지 못한 이유"
                  }
                },
                {
                  "type": "Callout",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "callout-fail-reason",
                    "title": "실패 사유 콜아웃"
                  },
                  "props": {
                    "title": {
                      "bind": "failReason.title",
                      "default": "{실패축} 문제로 담지 못했어요"
                    },
                    "children": {
                      "bind": "failReason.message",
                      "default": "아래 검증 결과를 확인하고 구성을 조정해 주세요."
                    }
                  }
                },
                {
                  "type": "TextButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "textbtn-view-later",
                    "title": "나중에 다시 보기"
                  },
                  "props": {
                    "label": "나중에 다시 보기",
                    "underline": true
                  }
                }
              ]
            },
            {
              "type": "area.dynamic",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-combo-result",
                "title": "검증 결과 리스트 스택"
              },
              "layout": "layout.area.listStack",
              "display": {
                "when": {
                  "bind": "comboResult.visible",
                  "default": true
                },
                "stateRole": "base"
              },
              "props": {
                "divider": "contents"
              },
              "children": [
                {
                  "type": "TitleSection",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "title-combo-result",
                    "title": "검증 결과 제목"
                  },
                  "props": {
                    "title": "검증 결과"
                  }
                },
                {
                  "type": "ListText",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "list-duplicate-check",
                    "title": "중복가입 판정"
                  },
                  "props": {
                    "table": "off",
                    "title": "중복가입 판정",
                    "subText": {
                      "bind": "duplicateCheck.statusText",
                      "default": "중복가입 불가"
                    },
                    "showRightItem": false
                  }
                },
                {
                  "type": "ListSelected",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "list-group-product",
                    "title": "그룹상품 선택"
                  },
                  "props": {
                    "type": "radio",
                    "label": {
                      "bind": "groupProduct.label",
                      "default": "그룹상품 선택"
                    },
                    "price": {
                      "bind": "groupProduct.price",
                      "default": ""
                    },
                    "checked": {
                      "bind": "groupProduct.checked",
                      "default": false
                    },
                    "showPrice": true,
                    "showButton": false
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Screen.Bottom",
          "componentVersion": "1.0.0",
          "metadata": {
            "id": "region-bottom",
            "title": "하단"
          },
          "layout": "layout.region.bottom",
          "children": [
            {
              "type": "area.static",
              "componentVersion": "1.0.0",
              "metadata": {
                "id": "area-bottom-action",
                "title": "하단 액션 영역"
              },
              "layout": "layout.area.bottomActionArea",
              "children": [
                {
                  "type": "ActionButton",
                  "componentVersion": "1.0.0",
                  "metadata": {
                    "id": "action-recover",
                    "title": "계속하기"
                  },
                  "props": {
                    "type": "Default",
                    "button": "1",
                    "primaryText": "계속하기"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
