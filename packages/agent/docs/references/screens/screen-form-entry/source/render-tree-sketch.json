{
	"schema": "reference-render-tree-sketch.v1",
	"referenceId": "screen-form-entry",
	"note": "Minimal RenderTree-oriented structure sketch. Values are illustrative; preserve the hierarchy and roles, not the literal labels.",
	"tree": {
		"type": "Screen",
		"children": [
			{
				"type": "Screen.Header",
				"role": "navigation",
