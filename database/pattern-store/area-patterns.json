{
	"patterns": [
		{
			"id": "list-stack",
			"target": "area",
			"name": "리스트 스택",
			"description": "Area children을 리스트형 항목으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 8,
				"props": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 8
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["list-cell"]
				},
				"keywords": ["list", "목록"],
				"priority": 80
			}
		},
		{
			"id": "field-stack",
			"target": "area",
			"name": "필드 스택",
			"description": "Area children을 입력 필드 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"props": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["text-field"]
				},
				"keywords": ["field", "form", "입력"],
				"priority": 80
			}
		},
		{
			"id": "checkbox-stack",
			"target": "area",
			"name": "체크박스 스택",
			"description": "Area children을 체크/동의 항목 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"props": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["checkbox"]
				},
				"keywords": ["checkbox", "check", "동의"],
				"priority": 70
			}
		},
		{
			"id": "message-stack",
			"target": "area",
			"name": "메시지 스택",
			"description": "Area children을 안내/상태 메시지 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"props": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["section-message"],
					"noneOf": ["text-field", "list-cell", "checkbox"]
				},
				"keywords": ["message", "status", "안내", "상태"],
				"priority": 60
			}
		}
	]
}
