{
	"patterns": [
		{
			"id": "list-stack",
			"target": "area",
			"name": "리스트 스택",
			"description": "Area children을 리스트형 항목으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 8,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 8
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["list-cell"]
				},
				"keywords": ["list", "목록"],
				"priority": 80
			}
		},
		{
			"id": "field-stack",
			"target": "area",
			"name": "필드 스택",
			"description": "Area children을 입력 필드 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["text-field"]
				},
				"keywords": ["field", "form", "입력"],
				"priority": 80
			}
		},
		{
			"id": "checkbox-stack",
			"target": "area",
			"name": "체크박스 스택",
			"description": "Area children을 체크/동의 항목 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["checkbox"]
				},
				"keywords": ["checkbox", "check", "동의"],
				"priority": 70
			}
		},
		{
			"id": "accordion-list",
			"target": "area",
			"name": "아코디언 리스트",
			"description": "Area children을 헤더 + 펼침 본문 구조로 묶어, 펼쳐진 헤더 아래에 본문 슬롯을 인라인으로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 0,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 0
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["list-cell", "accordion"]
				},
				"keywords": ["accordion", "expand", "약관", "펼침"],
				"priority": 90
			}
		},
		{
			"id": "message-stack",
			"target": "area",
			"name": "메시지 스택",
			"description": "Area children을 안내/상태 메시지 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 8,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["section-message"],
					"noneOf": ["text-field", "list-cell", "checkbox"]
				},
				"keywords": ["message", "status", "안내", "상태"],
				"priority": 60
			}
		},
		{
			"id": "action-stack",
			"target": "area",
			"name": "액션 스택",
			"description": "Area children을 일반 액션 묶음으로 세로 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 0,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["button"]
				},
				"keywords": ["action", "button", "cta", "버튼", "액션"],
				"priority": 75
			}
		},
		{
			"id": "bottom-action-area",
			"target": "area",
			"name": "하단 액션 영역",
			"description": "Screen Bottom region에 고정되는 주요 CTA 액션을 배치하는 레이아웃 프리셋",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 12,
				"paddingY": 0,
				"layoutProps": {
					"flow": "vertical",
					"titleGap": 0,
					"componentGap": 12
				}
			},
			"match": {
				"componentTypes": {
					"allOf": ["button"]
				},
				"keywords": ["bottom", "action", "cta", "하단", "다음", "확인"],
				"priority": 95
			}
		}
	]
}
