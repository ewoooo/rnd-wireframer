{
	"patterns": [
		{
			"id": "component-text-field",
			"target": "composite",
			"name": "텍스트 필드",
			"description": "단일 TextField render component를 field item으로 배치하는 컴포넌트 패턴",
			"layout": {
				"direction": "vertical",
				"childOrder": "explicit",
				"gap": 0
			},
			"match": {
				"componentTypes": {
					"allOf": ["text-field"]
				},
				"keywords": ["text-field", "field", "input"],
				"priority": 80
			}
		},
		{
			"id": "component-section-message",
